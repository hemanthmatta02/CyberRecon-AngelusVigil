# CyberRecon + CyberSentinel local development
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_KEY=
# Replace these values for any non-local deployment.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ALLOW_DEMO_AUTH=true
ALLOW_PUBLIC_REGISTRATION=true
CORS_ORIGINS=http://localhost:46969
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ANALYST_PASSWORD=Analyst@123
DEFAULT_VIEWER_PASSWORD=Viewer@123

POSTGRES_DB=cybersentinel
POSTGRES_USER=vigil
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://vigil:devpassword@postgres:5432/cybersentinel

REDIS_URL=redis://redis:6379

GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb
NGINX_LOG_PATH=/var/log/nginx/access.log

MODEL_DIR=/app/data/models
SKIP_AUTO_TRAIN=true

RAW_QUEUE_SIZE=1000
PARSED_QUEUE_SIZE=500
FEATURE_QUEUE_SIZE=200
ALERT_QUEUE_SIZE=100
BATCH_SIZE=32
BATCH_TIMEOUT_MS=50

POSTGRES_HOST_PORT=16969
REDIS_HOST_PORT=26969
BACKEND_HOST_PORT=36969
FRONTEND_HOST_PORT=46969

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MANUAL_ALLOWED_HOSTS=devlog-nginx,vigil-devlog-nginx,localhost,127.0.0.1